results/*_smoke.csv
results/*_pytest_integration.csv
results/expanding_pi_filter_pytest_integration.csv
results/expanding_returns_pytest_integration.csv
results/expanding_summary_pytest_integration.csv

# Pipeline outputs that land at the repo root. scripts/tree_combo_grouped.py
# (Step 16) writes tree_combo_grouped_results.xlsx to cwd, so tracking it means
# a clean checkout goes dirty on every run. Regenerate via run_pipeline.py.
tree_combo_grouped_results.xlsx
tree_combo_results.xlsx

